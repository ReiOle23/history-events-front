---
import ancientAgeMap from "../../../assets/ancient-age.webp";
import medievalAgeMap from "../../../assets/medieval-age.webp";
import modernAgeMap from "../../../assets/modern-age.webp";
import generalExample from "../../../assets/generalExample.webp";
import EventBar from "../../world-map/components/EventBar.astro";
import defaultEvents from "../../world-map/data/events.json";

// Each event's `age` picks the era-appropriate map raster, same as the SVG map.
const AGE_MAPS: Record<string, string> = {
  "Ancient History": ancientAgeMap.src,
  "Post-Classical / Medieval Period": medievalAgeMap.src,
  "Early Modern Period": modernAgeMap.src,
};
const mapForAge = (age: string): string => AGE_MAPS[age] ?? modernAgeMap.src;

interface HistoryEvent {
  year: number;
  text: string;
  lat: number;
  lng: number;
  characters: string[];
  age: string;
}

interface Props {
  events?: HistoryEvent[];
}

const { events = defaultEvents } = Astro.props;

// The map plane is an equirectangular sheet laid on the ground: 360° of
// longitude across X, 180° of latitude across Z, at 1 unit per 10 degrees.
const PLANE_W = 36;
const PLANE_H = 18;
const UNITS_PER_DEGREE = PLANE_W / 360;

// Longitude runs along +X. The plane is rotated -90° about X, which sends its
// local +Y (the top of the texture, i.e. the north pole) to world -Z, so
// latitude is negated to place events correctly.
const project = (lng: number, lat: number) => ({
  x: lng * UNITS_PER_DEGREE,
  z: -lat * UNITS_PER_DEGREE,
});

const timeline = events.map((event) => ({
  year: event.year,
  text: event.text,
  characters: event.characters,
  age: event.age,
  mapSrc: mapForAge(event.age),
  ...project(event.lng, event.lat),
}));

const initialMapSrc = mapForAge(events[0]?.age ?? "");
---

<div
  id="three-root"
  data-map-src={initialMapSrc}
  data-character-src={generalExample.src}
  data-timeline={JSON.stringify(timeline)}
  data-plane={JSON.stringify({
    width: PLANE_W,
    height: PLANE_H,
    unitsPerDegree: UNITS_PER_DEGREE,
  })}
  class="relative h-screen w-screen overflow-hidden bg-[#1c1109]"
>
  <canvas id="three-canvas" class="block h-full w-full"></canvas>

  <a
    href="/"
    class="fixed left-4 top-4 z-20 flex items-center gap-2 rounded-full border-2 border-[#9c7a24] bg-[#2a1608]/85 px-4 py-2 font-serif text-sm font-bold text-[#c9a13b] transition-colors hover:bg-[#4a2c14]"
  >
    ← Main page
  </a>

  <div
    id="event-card"
    class="pointer-events-none absolute inset-x-0 top-6 mx-auto w-fit max-w-[85%] rounded-lg border-2 border-[#9c7a24] bg-[#2a1608]/90 px-6 py-3 text-center opacity-0 transition-opacity duration-500 [text-shadow:0_1px_2px_rgba(0,0,0,0.8)]"
  >
    <p id="event-year" class="font-serif text-2xl font-bold text-[#c9a13b]"></p>
    <p id="event-text" class="font-serif text-base text-[#e8d9b5]"></p>
    <p id="event-characters" class="font-serif text-sm text-[#c9a13b]/80"></p>
  </div>

  <p
    class="pointer-events-none fixed right-4 top-4 z-20 font-serif text-sm text-[#c9a13b]/80 [text-shadow:0_1px_2px_rgba(0,0,0,0.8)]"
  >
    Drag to orbit · scroll to zoom
  </p>

  <EventBar events={events} />
</div>

<script>
  // Plain (hoisted) script so Vite bundles the bare `three` imports; runtime
  // data arrives via the root's data-* attributes (define:vars would inline it).
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { mergeGeometries } from "three/examples/jsm/utils/BufferGeometryUtils.js";
  import { feature, merge } from "topojson-client";
  import type { GeometryCollection, Topology } from "topojson-specification";
  import countries110m from "world-atlas/countries-110m.json";

  interface TimelineEntry {
    year: number;
    text: string;
    characters: string[];
    age: string;
    mapSrc: string;
    x: number;
    z: number;
  }

  const root = document.getElementById("three-root") as HTMLElement;
  const canvas = document.getElementById("three-canvas") as HTMLCanvasElement;
  const timeline: TimelineEntry[] = JSON.parse(root.dataset.timeline!);
  const plane: { width: number; height: number; unitsPerDegree: number } =
    JSON.parse(root.dataset.plane!);
  const UNITS_PER_DEGREE = plane.unitsPerDegree;
  const initialMapSrc = root.dataset.mapSrc!;

  const yearEl = document.getElementById("event-year") as HTMLElement;
  const textEl = document.getElementById("event-text") as HTMLElement;
  const charactersEl = document.getElementById(
    "event-characters",
  ) as HTMLElement;
  const card = document.getElementById("event-card") as HTMLElement;

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.outputColorSpace = THREE.SRGBColorSpace;

  const scene = new THREE.Scene();
  scene.background = new THREE.Color("#1c1109");

  const camera = new THREE.PerspectiveCamera(50, 1, 0.05, 400);

  const controls = new OrbitControls(camera, renderer.domElement);
  controls.enableDamping = true;
  controls.maxPolarAngle = Math.PI / 2 - 0.05; // stay above the map plane

  scene.add(new THREE.AmbientLight(0xffffff, 1.1));
  const key = new THREE.DirectionalLight(0xffe9c9, 1.1);
  key.position.set(6, 14, 7);
  scene.add(key);
  const rim = new THREE.DirectionalLight(0x9ac0e0, 0.35);
  rim.position.set(-8, 6, -6);
  scene.add(rim);

  // The map: the era raster textured onto a flat plane laid on the ground.
  const mapMaterial = new THREE.MeshStandardMaterial({
    color: "#ffffff",
    roughness: 1,
    transparent: true,
  });
  const mapMesh = new THREE.Mesh(
    new THREE.PlaneGeometry(plane.width, plane.height),
    mapMaterial,
  );
  mapMesh.rotation.x = -Math.PI / 2; // lie flat
  scene.add(mapMesh);

  // Era rasters are swapped in as the tour moves between ages; each one is
  // fetched once and reused.
  const textureLoader = new THREE.TextureLoader();
  const textureCache = new Map<string, THREE.Texture>();
  let currentMapSrc: string | null = null;

  function setMapTexture(src: string) {
    if (src === currentMapSrc) return;
    currentMapSrc = src;
    const cached = textureCache.get(src);
    if (cached) {
      mapMaterial.map = cached;
      mapMaterial.needsUpdate = true;
      return;
    }
    textureLoader.load(src, (texture) => {
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
      textureCache.set(src, texture);
      if (currentMapSrc !== src) return; // a later event already moved on
      mapMaterial.map = texture;
      mapMaterial.needsUpdate = true;
    });
  }
  setMapTexture(initialMapSrc);

  // Close in, the era raster is magnified far past its pixel resolution, so the
  // scene crossfades to vector countries built from the same topojson the SVG
  // map uses. Those stay crisp at any zoom.
  //
  // The vector sheet is also dressed for the era of the current event. Modern
  // national borders would be an anachronism on an ancient or medieval map, so
  // those ages show a dissolved landmass silhouette instead, in their own
  // parchment and sea tones.
  interface AgeStyle {
    sea: string;
    land: string; // silhouette tone for the ages that draw no borders
    palette: string[]; // per-country tints, only used when borders are drawn
    coast: string;
    borders: boolean;
  }

  const AGE_STYLES: Record<string, AgeStyle> = {
    "Ancient History": {
      sea: "#7aa6bd",
      land: "#d3bb8c",
      palette: ["#d3bb8c"],
      coast: "#4a3a20",
      borders: false,
    },
    "Post-Classical / Medieval Period": {
      sea: "#5f93b2",
      land: "#cdb185",
      palette: ["#cdb185"],
      coast: "#43301a",
      borders: false,
    },
    // By the early modern age, charted nations are the point of the map, so the
    // per-country tints of the SVG map come back.
    "Early Modern Period": {
      sea: "#4f86b6",
      land: "#c9b083",
      palette: [
        "#c9b083", // parchment tan
        "#c3a878", // deeper tan
        "#cdb78e", // pale wheat
        "#bfa878", // olive tan
        "#c7ad7d", // aged straw
      ],
      coast: "#3a2414",
      borders: true,
    },
  };
  const FALLBACK_AGE = "Early Modern Period";
  const styleForAge = (age: string): AgeStyle =>
    AGE_STYLES[age] ?? AGE_STYLES[FALLBACK_AGE];

  const hashSeed = (str: string): number => {
    let hash = 0;
    for (let i = 0; i < str.length; i++) {
      hash = (hash * 31 + str.charCodeAt(i)) >>> 0;
    }
    return hash || 1;
  };

  type Position = [number, number];
  type PolygonGeometry = { type: "Polygon"; coordinates: Position[][] };
  type MultiPolygonGeometry = {
    type: "MultiPolygon";
    coordinates: Position[][][];
  };
  type CountryGeometry = PolygonGeometry | MultiPolygonGeometry;

  // Unwrap longitude relative to the previous point so rings crossing the
  // antimeridian (Russia, Fiji) run off the edge of the sheet instead of
  // streaking straight back across it.
  const unwrapRing = (ring: Position[]): Position[] => {
    let previousLng = ring[0][0];
    return ring.map(([lng, lat], i) => {
      let unwrapped = lng;
      if (i > 0) {
        while (unwrapped - previousLng > 180) unwrapped -= 360;
        while (unwrapped - previousLng < -180) unwrapped += 360;
      }
      previousLng = unwrapped;
      return [unwrapped * UNITS_PER_DEGREE, lat * UNITS_PER_DEGREE] as Position;
    });
  };

  const topology = countries110m as unknown as Topology;
  const countryFeatures = (
    feature(
      topology,
      topology.objects.countries as GeometryCollection,
    ) as unknown as {
      features: { properties: { name: string }; geometry: CountryGeometry }[];
    }
  ).features;

  const shapeFromRings = (rings: Position[][]): THREE.Shape | null => {
    const [outer, ...holes] = rings;
    if (!outer || outer.length < 3) return null;
    const shape = new THREE.Shape(
      outer.map(([x, y]) => new THREE.Vector2(x, y)),
    );
    shape.holes = holes
      .filter((hole) => hole.length >= 3)
      .map(
        (hole) => new THREE.Path(hole.map(([x, y]) => new THREE.Vector2(x, y))),
      );
    return shape;
  };

  const pushRingSegments = (target: number[], ring: Position[]) => {
    for (let i = 0; i < ring.length; i++) {
      const [x1, y1] = ring[i];
      const [x2, y2] = ring[(i + 1) % ring.length];
      target.push(x1, y1, 0, x2, y2, 0);
    }
  };

  const lineSegmentsFrom = (points: number[], color: string, y: number) => {
    const geometry = new THREE.BufferGeometry();
    geometry.setAttribute(
      "position",
      new THREE.Float32BufferAttribute(points, 3),
    );
    const material = new THREE.LineBasicMaterial({
      color,
      transparent: true,
      opacity: 0,
      depthWrite: false,
    });
    const lines = new THREE.LineSegments(geometry, material);
    lines.rotation.x = -Math.PI / 2; // lie flat, north toward -Z
    lines.position.y = y;
    scene.add(lines);
    return { lines, material };
  };

  // Country layer: one merged mesh whose per-country tint rides in vertex
  // colors, so a palette change is a buffer rewrite rather than 177 materials.
  // `countryRanges` records which slice of that buffer belongs to which country.
  const landParts: THREE.BufferGeometry[] = [];
  const countryRanges: { start: number; count: number; hash: number }[] = [];
  const borderPoints: number[] = [];
  let vertexCursor = 0;

  for (const country of countryFeatures) {
    const hash = hashSeed(country.properties.name);
    const polygons =
      country.geometry.type === "Polygon"
        ? [country.geometry.coordinates]
        : country.geometry.coordinates;

    for (const polygon of polygons) {
      const rings = polygon.map(unwrapRing);
      const shape = shapeFromRings(rings);
      if (!shape) continue;

      const geometry = new THREE.ShapeGeometry(shape);
      const vertexCount = geometry.attributes.position.count;
      geometry.setAttribute(
        "color",
        new THREE.BufferAttribute(new Float32Array(vertexCount * 3), 3),
      );
      landParts.push(geometry);
      countryRanges.push({ start: vertexCursor, count: vertexCount, hash });
      vertexCursor += vertexCount;

      rings.forEach((ring) => pushRingSegments(borderPoints, ring));
    }
  }

  const landMaterial = new THREE.MeshBasicMaterial({
    vertexColors: true,
    transparent: true,
    opacity: 0,
    depthWrite: false,
  });
  const landMesh = new THREE.Mesh(mergeGeometries(landParts), landMaterial);
  landMesh.rotation.x = -Math.PI / 2; // lie flat, north toward -Z
  landMesh.position.y = 0.004;
  scene.add(landMesh);

  const landColors = landMesh.geometry.attributes.color as THREE.BufferAttribute;
  const paletteColor = new THREE.Color();

  function paintCountries(palette: string[]) {
    for (const range of countryRanges) {
      paletteColor.set(palette[range.hash % palette.length]);
      for (let i = range.start; i < range.start + range.count; i++) {
        landColors.setXYZ(i, paletteColor.r, paletteColor.g, paletteColor.b);
      }
    }
    landColors.needsUpdate = true;
  }

  const { lines: borderLines, material: borderMaterial } = lineSegmentsFrom(
    borderPoints,
    "#3a2414",
    0.008,
  );

  // Silhouette layer for the ages before nation states: topojson `merge`
  // dissolves the shared arcs, leaving continents with coastlines but no
  // internal borders at all.
  const silhouette = merge(
    topology,
    (topology.objects.countries as GeometryCollection).geometries as Parameters<
      typeof merge
    >[1],
  ) as unknown as MultiPolygonGeometry;

  const silhouetteParts: THREE.BufferGeometry[] = [];
  const coastPoints: number[] = [];

  for (const polygon of silhouette.coordinates) {
    const rings = polygon.map(unwrapRing);
    const shape = shapeFromRings(rings);
    if (!shape) continue;
    silhouetteParts.push(new THREE.ShapeGeometry(shape));
    rings.forEach((ring) => pushRingSegments(coastPoints, ring));
  }

  const silhouetteMaterial = new THREE.MeshBasicMaterial({
    transparent: true,
    opacity: 0,
    depthWrite: false,
  });
  const silhouetteMesh = new THREE.Mesh(
    mergeGeometries(silhouetteParts),
    silhouetteMaterial,
  );
  silhouetteMesh.rotation.x = -Math.PI / 2;
  silhouetteMesh.position.y = 0.004;
  scene.add(silhouetteMesh);

  const { lines: coastLines, material: coastMaterial } = lineSegmentsFrom(
    coastPoints,
    "#3a2414",
    0.006,
  );

  // The sea runs wider than the raster so the rings that unwrap past ±180°
  // still sit on water rather than floating over the background.
  const seaMaterial = new THREE.MeshBasicMaterial({
    color: "#4f86b6",
    transparent: true,
    opacity: 0,
  });
  const seaMesh = new THREE.Mesh(
    new THREE.PlaneGeometry(plane.width * 1.2, plane.height),
    seaMaterial,
  );
  seaMesh.rotation.x = -Math.PI / 2;
  seaMesh.position.y = 0.002;
  scene.add(seaMesh);

  // Era dressing. Palettes are repainted at once (the country layer is hidden
  // in the ages that use silhouettes anyway); sea, coast and silhouette tones
  // ease across so an age change during the tour doesn't snap.
  const seaTarget = new THREE.Color();
  const coastTarget = new THREE.Color();
  const silhouetteTarget = new THREE.Color();
  let drawBorders = true;

  function applyAgeStyle(age: string) {
    const style = styleForAge(age);
    seaTarget.set(style.sea);
    coastTarget.set(style.coast);
    silhouetteTarget.set(style.land);
    drawBorders = style.borders;
    borderMaterial.color.set(style.coast);
    paintCountries(style.palette);
  }

  const initialStyle = styleForAge(timeline[0]?.age ?? FALLBACK_AGE);
  applyAgeStyle(timeline[0]?.age ?? FALLBACK_AGE);
  seaMaterial.color.set(initialStyle.sea);
  coastMaterial.color.set(initialStyle.coast);
  silhouetteMaterial.color.set(initialStyle.land);

  // Crossfade window, measured as camera distance to whatever it is orbiting:
  // full antique raster far out, full vector by the time an event is framed.
  const VECTOR_FADE_START = 11;
  const VECTOR_FADE_END = 5;
  const COLOR_EASE = 0.06;

  function updateVectorLayer() {
    seaMaterial.color.lerp(seaTarget, COLOR_EASE);
    coastMaterial.color.lerp(coastTarget, COLOR_EASE);
    silhouetteMaterial.color.lerp(silhouetteTarget, COLOR_EASE);

    const distance = camera.position.distanceTo(controls.target);
    const t = THREE.MathUtils.clamp(
      (VECTOR_FADE_START - distance) / (VECTOR_FADE_START - VECTOR_FADE_END),
      0,
      1,
    );
    mapMaterial.opacity = 1 - t;
    mapMesh.visible = t < 1;

    seaMaterial.opacity = t;
    landMaterial.opacity = t * 0.92;
    silhouetteMaterial.opacity = t * 0.92;
    coastMaterial.opacity = t * 0.8;
    borderMaterial.opacity = t * 0.55;

    seaMesh.visible = t > 0;
    coastLines.visible = t > 0;
    landMesh.visible = t > 0 && drawBorders;
    borderLines.visible = t > 0 && drawBorders;
    silhouetteMesh.visible = t > 0 && !drawBorders;
  }

  // The pin for whichever event is currently happening — the map carries no
  // markers for events that have not come up yet. Built like a campaign-map
  // counter: a dot on the exact coordinates, a staff, then a portrait and a
  // name plate standing above it.
  const DOT_RADIUS = 0.022;
  const POLE_HEIGHT = 0.34;
  const PORTRAIT_W = 0.34;
  const PORTRAIT_H = 0.42;
  const PLATE_W = 0.44;
  const PLATE_H = 0.11;
  const FRAME = 0.022;

  const pin = new THREE.Group();
  pin.visible = false;
  scene.add(pin);

  const dot = new THREE.Mesh(
    new THREE.CircleGeometry(DOT_RADIUS, 24),
    new THREE.MeshBasicMaterial({ color: "#1c1109" }),
  );
  dot.rotation.x = -Math.PI / 2;
  dot.position.y = 0.032; // above the vector sea/land/coast layers
  pin.add(dot);

  const pole = new THREE.Mesh(
    new THREE.CylinderGeometry(0.005, 0.005, POLE_HEIGHT, 8),
    new THREE.MeshBasicMaterial({ color: "#2a1608" }),
  );
  pole.position.y = POLE_HEIGHT / 2;
  pin.add(pole);

  const pulseRing = new THREE.Mesh(
    new THREE.RingGeometry(0.05, 0.062, 32),
    new THREE.MeshBasicMaterial({
      color: "#8a2020",
      transparent: true,
      side: THREE.DoubleSide,
    }),
  );
  pulseRing.rotation.x = -Math.PI / 2;
  pulseRing.position.y = 0.031;
  pin.add(pulseRing);

  // Everything above the staff billboards together so the counter always reads
  // face-on, however the map is tilted.
  const plaque = new THREE.Group();
  plaque.position.y = POLE_HEIGHT;
  pin.add(plaque);

  const portrait = new THREE.Group();
  portrait.position.y = PORTRAIT_H / 2;
  plaque.add(portrait);

  portrait.add(
    new THREE.Mesh(
      new THREE.PlaneGeometry(PORTRAIT_W + FRAME, PORTRAIT_H + FRAME),
      new THREE.MeshBasicMaterial({ color: "#9c7a24", side: THREE.DoubleSide }),
    ),
  );
  const portraitImage = new THREE.Mesh(
    new THREE.PlaneGeometry(PORTRAIT_W, PORTRAIT_H),
    new THREE.MeshBasicMaterial({ color: "#2a1608", side: THREE.DoubleSide }),
  );
  portraitImage.position.z = 0.002;
  portrait.add(portraitImage);

  textureLoader.load(root.dataset.characterSrc!, (texture) => {
    texture.colorSpace = THREE.SRGBColorSpace;
    const material = portraitImage.material as THREE.MeshBasicMaterial;
    material.map = texture;
    material.color.set("#ffffff");
    material.needsUpdate = true;
  });

  // Name plate, drawn to a canvas because three has no text of its own. One
  // texture per label, cached, since the tour revisits the same characters.
  const plateTextures = new Map<string, THREE.CanvasTexture>();

  function plateTexture(label: string): THREE.CanvasTexture {
    const cached = plateTextures.get(label);
    if (cached) return cached;

    const canvas = document.createElement("canvas");
    canvas.width = 512;
    canvas.height = 128;
    const ctx = canvas.getContext("2d")!;
    ctx.fillStyle = "#2a1608";
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = "#9c7a24";
    ctx.lineWidth = 8;
    ctx.strokeRect(4, 4, canvas.width - 8, canvas.height - 8);

    ctx.fillStyle = "#e8d9b5";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    // Shrink the type until the label fits inside the plate's margins.
    let fontSize = 62;
    do {
      ctx.font = `bold ${fontSize}px Georgia, serif`;
      fontSize -= 2;
    } while (ctx.measureText(label).width > canvas.width - 48 && fontSize > 18);
    ctx.fillText(label, canvas.width / 2, canvas.height / 2 + 4);

    const texture = new THREE.CanvasTexture(canvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = renderer.capabilities.getMaxAnisotropy();
    plateTextures.set(label, texture);
    return texture;
  }

  const namePlate = new THREE.Mesh(
    new THREE.PlaneGeometry(PLATE_W, PLATE_H),
    new THREE.MeshBasicMaterial({ transparent: true, side: THREE.DoubleSide }),
  );
  plaque.add(namePlate);

  // Camera framing: an overview of the whole sheet, and the close-in view the
  // camera settles into over each event location.
  const OVERVIEW_TARGET = new THREE.Vector3(0, 0, 0);
  const OVERVIEW_POSITION = new THREE.Vector3(0, 22, 15);
  const FOCUS_DISTANCE = 2.9;
  const MIN_FOCUS_POLAR = 0.35;
  const MAX_FOCUS_POLAR = 1;

  const TRAVEL_MS = 2600;
  const DWELL_MS = 2200;
  const START_DELAY_MS = 1000;

  const easeInOutCubic = (t: number) =>
    t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

  camera.position.copy(OVERVIEW_POSITION);
  controls.target.copy(OVERVIEW_TARGET);

  // Keep whatever azimuth the user has orbited to, but pull the camera in to
  // the focus distance and a readable tilt for the flight's destination.
  const spherical = new THREE.Spherical();
  function focusOffset() {
    spherical.setFromVector3(camera.position.clone().sub(controls.target));
    spherical.radius = FOCUS_DISTANCE;
    spherical.phi = THREE.MathUtils.clamp(
      spherical.phi,
      MIN_FOCUS_POLAR,
      MAX_FOCUS_POLAR,
    );
    return new THREE.Vector3().setFromSpherical(spherical);
  }

  interface Flight {
    fromPosition: THREE.Vector3;
    fromTarget: THREE.Vector3;
    toPosition: THREE.Vector3;
    toTarget: THREE.Vector3;
    startedAt: number;
    onArrive?: () => void;
  }

  let flight: Flight | null = null;
  let dwellUntil = 0;
  let activeIndex = -1;
  let autoplay = true;
  let startTimeout: ReturnType<typeof setTimeout> | null = null;

  function flyTo(
    targetPoint: THREE.Vector3,
    offset: THREE.Vector3,
    onArrive?: () => void,
  ) {
    flight = {
      fromPosition: camera.position.clone(),
      fromTarget: controls.target.clone(),
      toPosition: targetPoint.clone().add(offset),
      toTarget: targetPoint.clone(),
      startedAt: performance.now(),
      onArrive,
    };
  }

  // Light up the matching step in the event bar, same treatment as the SVG map.
  function updateActiveButton(index: number) {
    document.querySelectorAll("[data-event-index]").forEach((button) => {
      const isActive =
        Number((button as HTMLElement).dataset.eventIndex) === index;
      button.classList.toggle("bg-[#c9a13b]", isActive);
      button.classList.toggle("text-[#2a1608]", isActive);
      button.classList.toggle("bg-[#3a2414]", !isActive);
      button.classList.toggle("text-[#c9a13b]", !isActive);
    });
  }

  function showEvent(index: number, { chain = false } = {}) {
    const entry = timeline[index];
    if (!entry) return;

    activeIndex = index;
    yearEl.textContent = String(entry.year);
    textEl.textContent = entry.text;
    charactersEl.textContent = entry.characters.join(" · ");
    card.classList.remove("opacity-0");
    setMapTexture(entry.mapSrc);
    applyAgeStyle(entry.age);

    // The pin only exists for the event that is happening right now; it moves
    // with the tour. Named characters get the portrait, everything else just
    // carries a plate with the year.
    pin.position.set(entry.x, 0, entry.z);
    pin.visible = true;

    const hasCharacter = entry.characters.length > 0;
    portrait.visible = hasCharacter;
    namePlate.position.y = hasCharacter
      ? PORTRAIT_H + 0.03 + PLATE_H / 2
      : PLATE_H / 2;
    (namePlate.material as THREE.MeshBasicMaterial).map = plateTexture(
      hasCharacter ? entry.characters[0] : String(entry.year),
    );
    (namePlate.material as THREE.MeshBasicMaterial).needsUpdate = true;

    updateActiveButton(index);

    const destination = new THREE.Vector3(entry.x, 0, entry.z);
    flyTo(destination, focusOffset(), () => {
      if (!chain || !autoplay) return;
      dwellUntil = performance.now() + DWELL_MS;
    });
  }

  function finishTour() {
    activeIndex = -1;
    pin.visible = false;
    updateActiveButton(-1);
    flyTo(
      OVERVIEW_TARGET,
      OVERVIEW_POSITION.clone().sub(OVERVIEW_TARGET),
      () => {
        card.classList.add("opacity-0");
      },
    );
  }

  // The event bar (or any host page) can steer the tour to a single event.
  window.addEventListener("map:select-event", (event) => {
    autoplay = false;
    dwellUntil = 0;
    if (startTimeout) clearTimeout(startTimeout);
    showEvent((event as CustomEvent<{ index: number }>).detail.index);
  });

  startTimeout = setTimeout(
    () => showEvent(0, { chain: true }),
    START_DELAY_MS,
  );

  function resize() {
    const w = root.clientWidth;
    const h = root.clientHeight;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  window.addEventListener("resize", resize);
  resize();

  renderer.setAnimationLoop((now) => {
    if (flight) {
      const t = Math.min((now - flight.startedAt) / TRAVEL_MS, 1);
      const eased = easeInOutCubic(t);
      camera.position.lerpVectors(flight.fromPosition, flight.toPosition, eased);
      controls.target.lerpVectors(flight.fromTarget, flight.toTarget, eased);
      if (t >= 1) {
        const { onArrive } = flight;
        flight = null;
        onArrive?.();
      }
    } else if (dwellUntil && now >= dwellUntil) {
      // Dwell over: on to the next event, or back out to the world view.
      dwellUntil = 0;
      if (activeIndex < timeline.length - 1) {
        showEvent(activeIndex + 1, { chain: true });
      } else {
        finishTour();
      }
    }

    if (pin.visible) {
      // The counter is sized against the camera distance so it keeps roughly
      // the same screen size however far the user has zoomed.
      const distance = camera.position.distanceTo(controls.target);
      pin.scale.setScalar(
        THREE.MathUtils.clamp(distance / FOCUS_DISTANCE, 0.4, 2.5),
      );

      // Full billboard on the plaque only: the staff and the dot stay planted
      // on the map, while portrait and plate read face-on at any map tilt.
      plaque.quaternion.copy(camera.quaternion);

      const pulse = (now % 1600) / 1600;
      pulseRing.scale.setScalar(1 + pulse * 1.6);
      (pulseRing.material as THREE.MeshBasicMaterial).opacity = 0.7 * (1 - pulse);
    }

    controls.update();
    updateVectorLayer();
    renderer.render(scene, camera);
  });
</script>
